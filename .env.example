# Copy to .env and adjust. `npm start` loads .env automatically if present.

# Required: source address of the trusted remote proxy (localhost is always allowed).
HERDR_ALLOWED_PEER_ADDRESS=127.0.0.1

# Unix socket of the running HERDR process (required when a tool is called).
HERDR_SOCKET_PATH=/path/to/herdr.sock

# Directory whose immediate subdirectories list_projects reports.
# Leave unset to disable list_projects so no directory listing is exposed.
# HERDR_PROJECTS_ROOT=~/projects

# HERDR_LISTEN_HOST=127.0.0.1
# HERDR_LISTEN_PORT=8787
# HERDR_MAX_READ_BYTES=65536
